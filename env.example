# Only needed when the app talks to a deployed Worker, e.g. popup.<your-subdomain>.workers.dev.
# In dev, the app reaches wrangler through the Next.js dev server.
NEXT_PUBLIC_PARTYKIT_HOST=

# Overrides the caption engine in src/app/captioning/config.ts: web-speech | local-model | zoom-scribe
NEXT_PUBLIC_CAPTION_ENGINE=

# Used by the party Worker (never sent to phones). Local dev reads it from .env;
# for deploys run `npx wrangler secret put ZOOM_API_KEY`.
ZOOM_API_KEY=