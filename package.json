{
	"name": "popup",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"dev:https": "node scripts/dev-cert.mjs && next dev --experimental-https --experimental-https-key certificates/dev-key.pem --experimental-https-cert certificates/dev-cert.pem",
		"dev:party": "wrangler dev",
		"dev-app": "concurrently \"npm run dev:https\" \"npm run dev:party\"",
		"deploy:party": "wrangler deploy",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:e2e": "npx playwright test",
		"test:e2e:ui": "npx playwright test --ui"
	},
	"dependencies": {
		"@huggingface/transformers": "^4.3.2",
		"@radix-ui/react-dialog": "^1.1.6",
		"classnames": "^2.5.1",
		"lucide-react": "^0.475.0",
		"next": "16.4.6",
		"partysocket": "1.0.3",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-qr-code": "^2.0.15",
		"uuid": "^11.1.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261106.1",
		"@playwright/test": "^1.50.1",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.2.0",
		"@types/jest": "^29.5.14",
		"@types/node": "^20",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"concurrently": "^9.1.2",
		"eslint": "^9",
		"eslint-config-next": "16.4.6",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"partyserver": "^0.5.10",
		"postcss": "^8",
		"prettier": "3.4.2",
		"prettier-plugin-organize-imports": "4.1.0",
		"tailwindcss": "^3.4.1",
		"ts-jest": "^29.2.5",
		"ts-node": "^10.9.2",
		"typescript": "^5",
		"wrangler": "^4.158.0"
	}
}
